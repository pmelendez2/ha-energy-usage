#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""Read-only snapshot of Home Assistant energy statistics."""

import hashlib
import os
import sqlite3
import sys
from datetime import datetime, timezone
from pathlib import Path


STATISTIC_IDS = (
    "energy_usage:electricity_meter_1",
    "energy_usage:gas_meter_2",
)

DEFAULT_DB = (
    Path.home()
    / "ha-energy-dev"
    / "config"
    / "home-assistant_v2.db"
)


def utc_time(value):
    """Convert a Unix timestamp into an ISO 8601 UTC timestamp."""
    if value is None:
        return "None"

    return datetime.fromtimestamp(
        value,
        tz=timezone.utc,
    ).isoformat()


def snapshot(connection, statistic_id):
    """Calculate and display statistics for one physical meter."""
    metadata = connection.execute(
        """
        SELECT id
        FROM statistics_meta
        WHERE statistic_id = ?
        """,
        (statistic_id,),
    ).fetchone()

    print(statistic_id)

    if metadata is None:
        print("  Statistic not found")
        print()
        return False

    rows = connection.execute(
        """
        SELECT start_ts, state, sum
        FROM statistics
        WHERE metadata_id = ?
        ORDER BY start_ts, id
        """,
        (metadata[0],),
    )

    digest = hashlib.sha256()
    count = 0
    unique = 0
    first = None
    last = None
    previous = None

    for start, state, total in rows:
        count += 1

        if start != previous or count == 1:
            unique += 1

        if first is None:
            first = start

        last = start
        previous = start

        record = f"{start!r}|{state!r}|{total!r}\n"
        digest.update(record.encode("utf-8"))

    print(f"  rows: {count}")
    print(f"  unique timestamps: {unique}")
    print(f"  duplicate timestamps: {count - unique}")
    print(f"  first UTC: {utc_time(first)}")
    print(f"  last UTC: {utc_time(last)}")
    print(f"  SHA256: {digest.hexdigest()}")
    print()

    return count > 0 and count == unique


def main():
    """Open Recorder read-only and verify both meter statistics."""
    if len(sys.argv) > 2:
        print(
            "Usage: recorder_snapshot [database_path]",
            file=sys.stderr,
        )
        return 2

    database = Path(
        sys.argv[1]
        if len(sys.argv) == 2
        else os.environ.get("HA_RECORDER_DB", DEFAULT_DB)
    ).expanduser().resolve()

    if not database.is_file():
        print(
            f"Recorder database not found: {database}",
            file=sys.stderr,
        )
        return 2

    print(f"Recorder database: {database}")
    print()

    try:
        connection = sqlite3.connect(
            database.as_uri() + "?mode=ro",
            uri=True,
            timeout=10,
        )

        try:
            connection.execute("PRAGMA query_only = ON")

            results = [
                snapshot(connection, statistic_id)
                for statistic_id in STATISTIC_IDS
            ]
        finally:
            connection.close()

    except sqlite3.Error as error:
        print(
            f"Recorder query failed: {error}",
            file=sys.stderr,
        )
        return 2

    if not all(results):
        print("Recorder verification: FAILED")
        return 1

    print("Recorder verification: PASS")
    return 0


if __name__ == "__main__":
    sys.exit(main())
